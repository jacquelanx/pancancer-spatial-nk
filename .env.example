# Copy to .env and fill in. Real environment variables always win over this file.
# The CLI loads .env automatically; nothing here is committed (.env is gitignored).

# --- Provider selection -------------------------------------------------------------
# anthropic | azure. If unset, Azure is used when its variables below are present.
PANSPATIAL_BACKEND=azure

# --- Azure OpenAI -------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure routes on DEPLOYMENT name, not model name. Map the logical model named in a
# prompt template to your deployment, so templates run unedited on either provider:
#   AZURE_OPENAI_DEPLOYMENTS=claude-opus-5=my-gpt5-deployment,fast=my-4o-mini-deployment
# A bare name maps to itself. The first entry is the default for any unmapped model.
AZURE_OPENAI_DEPLOYMENTS=

# Optional. Deployment capabilities are probed from the API's own 400 responses and
# cached per process; list them here to skip the probe.
#   Reasoning deployments (o-series, gpt-5): max_completion_tokens + reasoning_effort
#   Chat deployments (gpt-4o and similar):   max_tokens, no reasoning_effort
# AZURE_OPENAI_REASONING_DEPLOYMENTS=my-gpt5-deployment
# AZURE_OPENAI_CHAT_DEPLOYMENTS=my-4o-mini-deployment

# --- Anthropic ----------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# --- NCBI (phase 2 ingest) ----------------------------------------------------------
# NCBI_EMAIL=you@institution.edu
# NCBI_API_KEY=
