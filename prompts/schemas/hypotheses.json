{
  "type": "object",
  "properties": {
    "evidence_gate": {
      "type": "object",
      "properties": {
        "deconvolution_limited_findings": {"type": "array", "items": {"type": "string"}},
        "single_cell_resolution_findings": {"type": "array", "items": {"type": "string"}},
        "cancer_types_per_claim": {"type": "array", "items": {
          "type": "object",
          "properties": {
            "claim": {"type": "string"},
            "n_cancer_types": {"type": "integer"},
            "leave_one_out_range": {"type": "string"}
          },
          "required": ["claim", "n_cancer_types", "leave_one_out_range"],
          "additionalProperties": false
        }},
        "survival_evidence_is_same_cohort": {"type": "boolean"},
        "survival_models_adjusted_for_stage": {"type": "boolean"}
      },
      "required": ["deconvolution_limited_findings", "single_cell_resolution_findings",
                   "cancer_types_per_claim", "survival_evidence_is_same_cohort",
                   "survival_models_adjusted_for_stage"],
      "additionalProperties": false
    },
    "conserved_niches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "n_cancer_types": {"type": "integer"},
          "supporting_evidence": {"type": "string"},
          "confidence": {"type": "string", "enum": ["high", "moderate", "low"]}
        },
        "required": ["name", "description", "n_cancer_types", "supporting_evidence", "confidence"],
        "additionalProperties": false
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {"type": "string"},
          "architectural_basis": {"type": "string"},
          "supporting_observations": {"type": "array", "items": {"type": "string"}},
          "falsifier": {"type": "string"},
          "validation": {
            "type": "object",
            "properties": {
              "confirms_observation": {"type": "string"},
              "tests_mechanism": {"type": "string"},
              "mif_panel": {"type": "array", "items": {"type": "string"}},
              "functional_assay": {"type": "string"},
              "causal_perturbation": {"type": "string"}
            },
            "required": ["confirms_observation", "tests_mechanism", "mif_panel",
                         "functional_assay", "causal_perturbation"],
            "additionalProperties": false
          }
        },
        "required": ["statement", "architectural_basis", "supporting_observations",
                     "falsifier", "validation"],
        "additionalProperties": false
      }
    },
    "insufficient_evidence": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["evidence_gate", "conserved_niches", "hypotheses", "insufficient_evidence"],
  "additionalProperties": false
}
